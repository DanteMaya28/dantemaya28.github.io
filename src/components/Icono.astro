  linkedin: ['M4 6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z', 'M8 11v5', 'M8 8v.01', 'M12 16v-5', 'M16 16v-3a2 2 0 0 0 -4 0'],
