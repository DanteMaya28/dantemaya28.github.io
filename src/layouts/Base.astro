---
import '../styles/global.css';
import { perfil } from '../config';
import BarraLateral from '../components/BarraLateral.astro';
import Menu from '../components/Menu.astro';
import BotonTema from '../components/BotonTema.astro';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = perfil.descripcion } = Astro.props;
const anio = new Date().getFullYear();
---
<html lang="en" data-tema="claro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo} | {perfil.nombre}</title>
<script is:inline>
  try {
    if (localStorage.getItem('tema') === 'oscuro') {
      document.documentElement.dataset.tema = 'oscuro';
    }
  } catch {}
</script>
  </head>
  <body>
    <div class="contenedor">
      <BarraLateral />
      <div class="columna">
        <div class="barra-superior">
          <Menu />
          <BotonTema />
        </div>
        <main>
          <slot />
        </main>
        <footer class="pie">© {anio} {perfil.nombre}</footer>
      </div>
    </div>
  </body>
</html>